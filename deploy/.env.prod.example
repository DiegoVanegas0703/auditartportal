# Copiar a la raíz del repo en el servidor como `.env` (chmod 600).
# No commitear el archivo real.

ASPNETCORE_ENVIRONMENT=Production

# --- Base de datos ---
# Demo en VM (Postgres del compose): Host=db
# RDS externo: Host=TU_RDS... y comentá el servicio db en docker-compose.prod.yml
ConnectionStrings__Default=Host=db;Port=5432;Database=auditart;Username=auditart;Password=CAMBIAR
POSTGRES_PASSWORD=CAMBIAR

# --- JWT ---
Jwt__Key=CAMBIAR_POR_SECRETO_LARGO_ALEATORIO_MIN_32_CHARS
Jwt__Issuer=auditart
Jwt__Audience=auditart-web
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14

# --- CORS (origen exacto del portal: http://IP o https://dominio) ---
Cors__Origins__0=http://IP_PUBLICA_DE_TU_VM

# --- Storage local (demo; sin S3) ---
Aws__Region=us-east-1
Aws__S3__Bucket=auditart-local
Aws__S3__UseLocal=true

# --- Gmail canal general ---
Gmail__Enabled=true
Gmail__PollingEnabled=true
Gmail__PollingIntervalMinutes=5
Gmail__Mailbox=info@auditart.com.ar
Gmail__ClientId=
Gmail__ClientSecret=
Gmail__RefreshToken=
Gmail__SearchQuery=is:unread in:inbox
Gmail__MaxResults=50

# --- Gmail canal crónicos ---
Gmail__Cronicos__Enabled=false
Gmail__Cronicos__Mailbox=
Gmail__Cronicos__ClientId=
Gmail__Cronicos__ClientSecret=
Gmail__Cronicos__RefreshToken=

# Workers
ChronicRenewal__Enabled=true
SlaAlerts__Enabled=true
