# Copiar a la raíz del repo en el servidor como `.env` (chmod 600).
# No commitear el archivo real.

ASPNETCORE_ENVIRONMENT=Production

# --- Base de datos (RDS) ---
# Si usás Postgres del compose, Host=db
ConnectionStrings__Default=Host=TU_RDS.XXXX.rds.amazonaws.com;Port=5432;Database=auditart;Username=auditart;Password=CAMBIAR;SSL Mode=Require;Trust Server Certificate=true

# --- JWT ---
Jwt__Key=CAMBIAR_POR_SECRETO_LARGO_ALEATORIO_MIN_32_CHARS
Jwt__Issuer=auditart
Jwt__Audience=auditart-web
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14

# --- Google OAuth (login) ---
Google__ClientId=TU_CLIENT_ID.apps.googleusercontent.com

# --- CORS (origen exacto del portal) ---
Cors__Origins__0=https://app.tudominio.com

# --- S3 (IAM Role en EC2: no hace falta Access Key) ---
Aws__Region=us-east-1
Aws__S3__Bucket=auditart-docs-prod
Aws__S3__UseLocal=false

# --- Gmail canal general ---
Gmail__Enabled=true
Gmail__PollingEnabled=true
Gmail__PollingIntervalMinutes=5
Gmail__Mailbox=operaciones@tuempresa.com
Gmail__ClientId=
Gmail__ClientSecret=
Gmail__RefreshToken=
Gmail__SearchQuery=is:unread in:inbox
Gmail__MaxResults=50

# --- Gmail canal crónicos (opcional) ---
Gmail__Cronicos__Enabled=false
Gmail__Cronicos__Mailbox=
Gmail__Cronicos__ClientId=
Gmail__Cronicos__ClientSecret=
Gmail__Cronicos__RefreshToken=

# Workers
ChronicRenewal__Enabled=true
SlaAlerts__Enabled=true

# Solo si usás el servicio db del compose:
# POSTGRES_PASSWORD=CAMBIAR
