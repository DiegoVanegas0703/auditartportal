# Variables de entorno (copiar a .env y completar)
# No commitear secretos reales.

GOOGLE_CLIENT_ID=
JWT_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=auditart-docs-dev
Aws__S3__UseLocal=true

# Canal General (operación normal)
Gmail__Enabled=true
Gmail__Mailbox=info@auditart.com.ar
Gmail__General__Enabled=true
Gmail__General__Mailbox=info@auditart.com.ar
Gmail__ClientId=
Gmail__ClientSecret=
Gmail__RefreshToken=

# Canal Crónicos (confirmar mailbox real con el cliente)
Gmail__Cronicos__Enabled=true
Gmail__Cronicos__Mailbox=cronicos@auditart.com.ar
Gmail__Cronicos__ClientId=
Gmail__Cronicos__ClientSecret=
Gmail__Cronicos__RefreshToken=

DATABASE_URL=Host=localhost;Port=5433;Database=auditart;Username=auditart;Password=auditart_dev
ConnectionStrings__Default=Host=localhost;Port=5433;Database=auditart;Username=auditart;Password=auditart_dev

# WhatsApp Cloud API (Meta)
WhatsApp__Enabled=false
WhatsApp__PhoneNumberId=
WhatsApp__AccessToken=
WhatsApp__ApiVersion=v21.0
WhatsApp__WebhookVerifyToken=
WhatsApp__StatusTemplateName=auditart_estado_actualizado
WhatsApp__StatusTemplateLanguage=es_AR
WhatsApp__NotifyOnStatuses=Amarillo,Verde

# Gemini chat embebido
Gemini__Enabled=false
Gemini__ApiKey=
Gemini__Model=gemini-2.0-flash
